<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标（API 26+）。minSdk 就是 26，所以**不需要任何 PNG 兜底**：
  这个 App 装不到 Android 8.0 以下的机器上，那一整套 mipmap-hdpi/xhdpi/... 的
  位图连被读到的机会都没有。少五个目录、十张 PNG，APK 里也少几十 KB ——
  和「不引入 material-icons-extended」是同一条理由。

  背景刻意是一块纯色，没有渐变。Color.kt 里写着「不做彩色仪表盘，不做渐变噱头」，
  那条规矩管的是整个产品的表面，包括这里。启动器上一排彩色渐变图标之间，
  一块沉下去的钢青色本身就是识别度。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
